# Copy to .env.local and fill in. Never commit .env.local.

# Public site URL (used for metadata / share links)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Cashfree Payments — test keys from https://merchant.cashfree.com (Developers → API Keys).
# Leave the keys empty to run checkout in mock mode (simulated payment window).
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=
# "sandbox" for testing, "production" only when going live with live keys.
CASHFREE_ENV=sandbox
# The webhook URL to add in Cashfree: /api/pay/webhook (Cashfree signs it with the secret key above).

# OTP provider (MSG91 / Twilio Verify / Firebase). Leave empty for dev mode,
# where any 4-digit code is accepted.
OTP_PROVIDER_KEY=

# Cloudflare D1 database (Account ID, D1 database ID, and an API token with Account > D1 > Edit).
# Create the tables once with: npm run db:migrate
CF_ACCOUNT_ID=
CF_D1_DATABASE_ID=
CF_API_TOKEN=

# Encrypts guest names, phones, emails and GST details before they are stored (AES-256-GCM).
# 32 random bytes, base64. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Keep a safe copy: without this key the stored data cannot be read.
PII_ENCRYPTION_KEY=
