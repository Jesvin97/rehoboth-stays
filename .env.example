# Copy to .env.local and fill in. Never commit .env.local.

# Public site URL (used for metadata / share links)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Razorpay — get test keys from https://dashboard.razorpay.com (Settings → API Keys).
# Leave empty to run checkout in mock mode (simulated payment window).
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# OTP provider (MSG91 / Twilio Verify / Firebase). Leave empty for dev mode,
# where any 4-digit code is accepted.
OTP_PROVIDER_KEY=
